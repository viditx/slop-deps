+          <div
+            data-testid="readme-tier-table"
+            className="flex flex-col divide-y divide-[#F5F5F0]/12 border border-[#F5F5F0]/20"
+          >
+            <div className="hidden sm:grid grid-cols-[150px_90px_1fr] gap-x-3 px-3 py-1.5 bg-[#040507] font-pixel text-[9px] uppercase tracking-[0.08em] text-[#F5F5F0]/55">
+              <span>status</span>
+              <span>risk</span>
+              <span>meaning</span>
+            </div>
+            {TIERS.map((tier) => (
+              <div
+                key={tier.status}
+                data-testid={`readme-tier-${tier.status.toLowerCase()}`}
+                className="flex flex-col gap-1.5 sm:grid sm:grid-cols-[150px_90px_1fr] sm:gap-x-3 px-3 py-2.5 sm:items-start"
+              >
+                <div className="flex flex-wrap items-center gap-2 sm:contents">
+                  <span
+                    className={`font-terminal text-xs sm:text-[13px] font-bold ${tier.riskClass}`}
+                  >
+                    {tier.status}
+                  </span>
+                  <span
+                    className={`px-1.5 py-0.5 border font-pixel text-[9px] uppercase ${tier.riskClass}`}
+                  >
+                    {tier.risk}
+                  </span>
+                </div>
+                <span className="font-terminal text-[11px] sm:text-xs text-[#F5F5F0]/75 leading-snug">
+                  {tier.meaning}
+                </span>
+              </div>
+            ))}
+          </div>
+        </div>
+
+        {/* Capabilities grid */}
+        <div className="flex flex-col gap-3">
+          <h3 className="font-pixel text-xs sm:text-sm uppercase tracking-[0.12em] text-[#F5F5F0]">
+            core capabilities
+          </h3>
+          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
+            {CAPABILITIES.map((cap) => (
+              <div
