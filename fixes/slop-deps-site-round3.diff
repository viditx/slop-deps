+                @viditx
+              </a>{' '}
+              · MIT © 2026
+            </p>
+            <p className="mt-0.5 text-[#F5F5F0]/55">
+              written by a 15-year-old who red-teams his own code before
+              shipping it
+            </p>
+          </div>
+          <a
+            href={GITHUB_REPO_URL}
+            target="_blank"
+            rel="noreferrer"
+            data-testid="readme-github-link"
+            className="pixel-btn-anim pixel-btn-sheen inline-flex items-center gap-2 px-3.5 py-2 bg-[#F5F5F0] text-[#040507] font-pixel text-[10px] uppercase tracking-[0.08em] cursor-pointer"
+          >
+            <Github aria-hidden="true" className="w-3.5 h-3.5" strokeWidth={2.5} />
+            star on github
+          </a>
+        </div>
+      </div>
+    </section>
+  );
+}
