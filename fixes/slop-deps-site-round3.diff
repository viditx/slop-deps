+import { useState } from 'react';
+import { BookOpen, Github, ShieldCheck } from 'lucide-react';
+import { CatState, PixelSittingCat } from './PixelSittingCat';
+
+const GITHUB_REPO_URL = 'https://github.com/viditx/slop-deps';
+// Bump together with package.json on release.
+const VERSION = 'v1.4.0';
+
+interface Tier {
+  status: string;
+  risk: string;
+  meaning: string;
+  riskClass: string;
+}
+
+const TIERS: Tier[] = [
+  {
+    status: 'HALLUCINATED',
+    risk: 'CRITICAL',
+    meaning:
+      "Doesn't exist on npm / PyPI / crates.io. An attacker can register it right now — remove it immediately.",
+    riskClass: 'text-[#FB7185] border-[#FB7185]/50',
+  },
+  {
+    status: 'SUSPICIOUS',
+    risk: 'HIGH',
+    meaning:
+      'Registered under 30 days ago with two or fewer releases, or carries typosquat / install-script signals.',
+    riskClass: 'text-[#FCD34D] border-[#FCD34D]/50',
+  },
+  {
+    status: 'VERIFIED',
+    risk: 'CLEAN',
+    meaning: 'Established package with a verified release history.',
+    riskClass: 'text-emerald-400 border-emerald-400/50',
+  },
+];
+
+const CAPABILITIES: { title: string; body: string }[] = [
+  {
+    title: 'zero dependencies',
+    body: 'Built on Node 18+ native APIs only. A supply-chain auditor that depends on nobody — that is the whole point.',
+  },
+  {
+    title: 'typosquat engine',
+    body: 'Damerau-Levenshtein plus confusable-character normalization (m0rgan → morgan) over a 4,000+ name corpus, fully offline.',
+  },
+  {
+    title: 'three registries',
+    body: 'npm · PyPI · crates.io, verified live — with smart import→distribution mapping like cv2 → opencv-python.',
+  },
+  {
+    title: 'source-level scan',
+    body: 'Imports are pulled from raw source before they ever reach a manifest: .ts, .tsx, .vue, .svelte, .astro, .py, .pyi.',
+  },
+  {
+    title: 'monorepo aware',
+    body: 'workspace:* / file: / link: references and tsconfig path aliases are recognized and ignored — signal, not noise.',
+  },
+  {
+    title: 'fail-closed exits',
+    body: 'exit 1 on criticals, exit 2 on errors, exit 0 only when clean. Wire it into CI and forget about it.',
+  },
+];
+
+const SECURITY_CHIPS: string[] = [
+  'crash-proof requests',
+  'dns-rebinding guard',
+  'symlink containment',
+  'path traversal blocked',
+  'injection-guarded --fix',
+  'opt-in config trust',
+];
+
+function CopyChip() {
+  const [copied, setCopied] = useState(false);
+
+  const handleCopy = async () => {
+    try {
+      await navigator.clipboard.writeText('npx slop-deps');
+      setCopied(true);
+      window.setTimeout(() => setCopied(false), 1400);
+    } catch {
+      // Clipboard unavailable — ignore.
+    }
+  };
+
+  return (
+    <button
+      type="button"
+      data-testid="readme-npx-chip"
+      onClick={() => void handleCopy()}
+      className="group inline-flex items-center gap-2.5 px-3.5 py-2 bg-[#040507] border-2 border-[#F5F5F0]/40 hover:border-[#F5F5F0] text-[#F5F5F0] font-terminal text-sm pixel-btn-anim cursor-pointer"
+    >
+      <span className="text-[#F5F5F0]/55">$</span>
+      <span>npx slop-deps</span>
+      <span
+        aria-hidden="true"
+        className="inline-block w-1.5 h-3 bg-[#F5F5F0] animate-pulse"
+      />
+      <span
+        className={`ml-1 px-1.5 py-0.5 border bg-[#080A0F] font-pixel text-[9px] uppercase tracking-[0.06em] transition-colors duration-150 ${
+          copied
+            ? 'text-emerald-400 border-emerald-400/50'
+            : 'text-[#F5F5F0]/75 border-[#F5F5F0]/30 group-hover:text-[#F5F5F0]'
+        }`}
+      >
+        {copied ? 'copied' : 'copy'}
+      </span>
+    </button>
+  );
+}
+
+export function ReadmeSection() {
+  return (
