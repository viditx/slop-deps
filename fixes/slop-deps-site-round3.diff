+            <BookOpen aria-hidden="true" className="w-3.5 h-3.5" strokeWidth={2.5} />
+            readme.md
+          </span>
+          <span className="hidden sm:inline font-terminal text-[11px] text-[#F5F5F0]/50">
+            slop-deps · {VERSION}
+          </span>
+        </div>
+        <span className="font-terminal text-[11px] text-[#F5F5F0]/50">
+          same as on github
+        </span>
+      </div>
+
+      {/* Card body */}
+      <div className="pixel-card-clip border-2 border-[#F5F5F0]/40 bg-[#080A0F] p-5 sm:p-7 flex flex-col gap-7">
+        {/* Title block with the cat */}
+        <div className="flex items-start justify-between gap-4">
+          <div className="min-w-0">
+            <h2 className="font-pixel text-xl sm:text-2xl text-[#F5F5F0] tracking-[0.04em]">
+              slop-deps
+            </h2>
+            <p className="mt-1.5 font-terminal text-xs sm:text-sm text-[#F5F5F0]/70">
+              AI Dependency Hallucination &amp; Supply-Chain Sentinel ·{' '}
+              {VERSION}
+            </p>
+            <div className="mt-3 flex flex-wrap gap-1.5">
+              {['MIT license', '0 dependencies', 'node >= 18'].map((badge) => (
+                <span
+                  key={badge}
+                  className="pixel-pill-clip px-2 py-1 border border-[#F5F5F0]/25 bg-[#040507] font-pixel text-[9px] uppercase tracking-[0.06em] text-[#F5F5F0]/75"
+                >
+                  {badge}
+                </span>
+              ))}
+            </div>
+          </div>
+          {/* The resident cat, guarding the readme.
+              The SVG is fixed-size (144x110), so it is scaled down inside
+              a sized box: absolute inner keeps layout overflow at bay. */}
+          <div
+            data-testid="readme-guard-cat"
+            className="relative shrink-0 w-16 h-[58px] sm:w-[144px] sm:h-[132px] md:w-[166px] md:h-[148px] mt-1"
+            title="the resident cat, guarding the readme"
+          >
+            <div className="absolute top-0 left-0 origin-top-left scale-[0.44] sm:scale-100">
+              <PixelSittingCat state={CatState.Purring} />
+            </div>
+          </div>
+        </div>
+
+        {/* Pitch */}
+        <blockquote
+          data-testid="readme-pitch"
+          className="border-l-4 border-[#F5F5F0]/30 pl-4 py-1 font-terminal text-sm sm:text-[15px] leading-relaxed text-[#F5F5F0]/90"
+        >
+          Your AI invents package names that don&rsquo;t exist. Attackers
+          register those names and wait for someone to install them. This
+          catches it — before it reaches your lockfile.
+        </blockquote>
+
+        {/* Quick start */}
+        <div className="flex flex-col gap-3">
+          <h3 className="font-pixel text-xs sm:text-sm uppercase tracking-[0.12em] text-[#F5F5F0]">
+            quick start
+          </h3>
+          <p className="font-terminal text-xs sm:text-sm text-[#F5F5F0]/70 leading-relaxed">
+            No install step. One command checks every import in source and
+            manifests, across npm, PyPI, and crates.io. The repo even ships a{' '}
+            <span className="text-[#F5F5F0]">demo/</span> folder full of real
+            hallucinated imports — run it there first and watch the red flags.
+          </p>
+          <div className="flex flex-wrap items-center gap-3">
+            <CopyChip />
+            <code className="font-terminal text-xs text-[#F5F5F0]/60">
+              or: slop-deps --dir ./src · --json · --sarif · --staged
+            </code>
+          </div>
+        </div>
+
+        {/* The threat, in two numbers */}
+        <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
+          <div className="border border-[#FB7185]/30 bg-[#FB7185]/5 px-3.5 py-3">
+            <span
+              data-testid="readme-stat-percent"
+              className="font-pixel text-lg text-[#FB7185]"
+            >
+              5–21%
+            </span>
+            <p className="mt-1 font-terminal text-[11px] sm:text-xs text-[#F5F5F0]/70 leading-snug">
+              of package names suggested by Cursor / Copilot / Claude
+              don&rsquo;t exist at all
+            </p>
+          </div>
+          <div className="border border-[#FCD34D]/30 bg-[#FCD34D]/5 px-3.5 py-3">
+            <span
+              data-testid="readme-stat-repeat"
+              className="font-pixel text-lg text-[#FCD34D]"
+            >
+              43%
+            </span>
+            <p className="mt-1 font-terminal text-[11px] sm:text-xs text-[#F5F5F0]/70 leading-snug">
+              of hallucinated names repeat across runs — easy targets for
+              attackers to register (it&rsquo;s called slopsquatting)
+            </p>
+          </div>
+        </div>
+
+        {/* Verification tiers */}
+        <div className="flex flex-col gap-3">
+          <h3 className="font-pixel text-xs sm:text-sm uppercase tracking-[0.12em] text-[#F5F5F0]">
+            verification tiers
