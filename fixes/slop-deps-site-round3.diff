+        <div
+          data-testid="readme-security-block"
+          className="border border-emerald-400/30 bg-emerald-400/5 px-4 py-4 flex flex-col gap-3"
+        >
+          <div className="flex items-center justify-between gap-3 flex-wrap">
+            <h3 className="font-pixel text-xs sm:text-sm uppercase tracking-[0.12em] text-emerald-400">
