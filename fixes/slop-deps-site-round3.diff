+              >
+                <span className="font-pixel text-[10px] uppercase tracking-[0.08em] text-[#F5F5F0]">
+                  {cap.title}
+                </span>
+                <p className="mt-1.5 font-terminal text-[11px] sm:text-xs text-[#F5F5F0]/70 leading-snug">
+                  {cap.body}
+                </p>
+              </div>
+            ))}
+          </div>
+        </div>
+
