+            <span>
+              <span className="text-emerald-400 font-bold">61/61</span> tests
+              green
+            </span>
+            <span className="text-[#F5F5F0]/30" aria-hidden="true">
+              /
+            </span>
+            <span>
+              <span className="text-emerald-400 font-bold">11/11</span> attack
+              classes blocked
+            </span>
+          </div>
+        </div>
+
+        {/* Author / license footer */}
+        <div className="pt-1 border-t border-[#F5F5F0]/15 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3">
+          <div className="font-terminal text-[11px] sm:text-xs text-[#F5F5F0]/70 leading-relaxed">
